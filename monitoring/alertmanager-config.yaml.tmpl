# Alertmanager configuration template. install.sh fills in the ${...} values from the workspace secrets/ folder
# and stores the result as the Kubernetes Secret "alertmanager-finsecure" (never committed in rendered form).
global:
  smtp_smarthost: "${SMTP_HOST}:${SMTP_PORT}"
  smtp_from: "FinSecure Pay Alerts <${SMTP_USERNAME}>"
  smtp_auth_username: "${SMTP_USERNAME}"
  smtp_auth_password: "${SMTP_PASSWORD}"
  smtp_require_tls: true

route:
  receiver: "null"
  group_by: ["alertname", "namespace"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # Always-firing heartbeat alerts from kube-prometheus-stack: never notify
    - receiver: "null"
      matchers: ['alertname=~"Watchdog|InfoInhibitor"']
    # Application alerts (monitoring/app-monitoring.yaml) and any critical platform alert -> email
    - receiver: email
      matchers: ['team="finsecure"']
    - receiver: email
      matchers: ['severity="critical"']

inhibit_rules:
  # The app being completely down already explains missing replicas
  - source_matchers: ['alertname="TransactionValidatorDown"']
    target_matchers: ['alertname="TransactionValidatorReplicasUnavailable"']

receivers:
  - name: "null"
  - name: email
    email_configs:
      - to: "${ALERT_EMAIL_TO}"
        send_resolved: true
